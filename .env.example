# ============================================================
# GARUDA AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your actual API keys.
# ============================================================

# LLM Providers (OpenRouter is default primary provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Optional LLM Fallback Providers
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Web Search Intelligence (Tavily AI)
TAVILY_API_KEY=your_tavily_api_key_here

# Email Authentication & OTP Service (SMTP)
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password_here

# Memory / Performance Optimization Settings
# Set to true to load Faster-Whisper locally for voice transcription (requires ~1GB RAM)
GARUDA_ENABLE_WHISPER=false
